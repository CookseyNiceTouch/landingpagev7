# Origin this build is served from — drives canonicals, og:url and the sitemap.
# Leave unset for production (https://nicetouch.app). Any other value marks the
# whole build noindex; the staging site sets https://preview.nicetouch.app.
# VITE_SITE_URL=https://preview.nicetouch.app

# Public URL of the transcribe API (DEV-392).
# Local dev: leave as the local API.
# Production: set to https://api.nicetouch.app (or wherever the api/ service lives).
VITE_TRANSCRIBE_API_URL=http://localhost:8787

# Maximum audio duration shown in UI copy, in minutes (180 = 3 hours).
# Must match MAX_DURATION_MIN in api/.env.
VITE_MAX_DURATION_MIN=180
