# Required
ASSEMBLYAI_API_KEY=replace-me

# Optional — leave unset locally to use the in-memory fallback. Required for
# any multi-instance production deploy so the spend cap is shared.
# REDIS_URL=redis://localhost:6379

# Optional (defaults shown)
NODE_ENV=development
PORT=8787
ALLOWED_ORIGIN=https://nicetouch.app
DAILY_CAP_USD=127
RATE_PER_SEC=0.000103
MAX_BYTES=104857600
MAX_DURATION_MIN=180
